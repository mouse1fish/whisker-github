#!/usr/bin/env sh
# Whisker SDK wrapper (POSIX sh; runs Windows x64 wkcc2.exe)
# Usage:
#   whisker compile input.wk [output.exe]
#   whisker version
set -e
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "$1" in
    version|--version)
        echo "Whisker SDK (self-hosted compiler wkcc2)"; exit 0 ;;
    compile)
        shift ;;
    *)
        echo "Usage: whisker compile input.wk [output.exe]"; exit 1 ;;
esac
SRC=$1
[ -n "$SRC" ] || { echo "Usage: whisker compile input.wk [output.exe]"; exit 1; }
[ -f "$SRC" ] || { echo "Error: not found: $SRC"; exit 1; }
OUT=${2:-${SRC%.wk}.exe}
"$SELF_DIR/bin/wkcc2.exe" "$SRC" "$OUT" "$SELF_DIR/share/rt_blob.bin"
echo "OK: $OUT"