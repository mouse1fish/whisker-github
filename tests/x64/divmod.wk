# 除法/取模专项：常数除数走「乘魔数+移位」，负数走 idiv 慢路径
actor Main {
    on Start {
        s_mod: Int = 0
        s_div: Int = 0
        for i in 1 ..= 100000 {
            s_mod = s_mod + i % 1000
            s_div = s_div + i / 7
        }
        print("sum(i % 1000) = ", s_mod, "（期望 49950000）")
        print("sum(i / 7) = ", s_div, "（期望 714250000）")

        # 负数（走慢路径，必须仍是 C 的截断语义）
        print("-17 / 5 = ", -17 / 5, " -17 % 5 = ", -17 % 5, "（期望 -3 -2）")
        print("17 / -5 = ", 17 / -5, " 17 % -5 = ", 17 % -5, "（期望 -3 2）")
        print("-1 % 3 = ", -1 % 3, " -6 / 2 = ", -6 / 2, "（期望 -1 -3）")

        # 特殊除数
        print("12345 / 1 = ", 12345 / 1, " 12345 % 1 = ", 12345 % 1, "（期望 12345 0）")
        print("999983 * 4 = ", 999983 * 4, " (999983*4) % 999983 = ", (999983 * 4) % 999983,
              "（期望 3999932 0）")
    }
}