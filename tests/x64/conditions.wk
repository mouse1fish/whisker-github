// 条件求值对照测试：and / elif / not / 嵌套 if
actor Main {
    on Start {
        a: Int = 0
        b: Int = 0
        c: Int = 0
        d: Int = 0
        e: Int = 0

        i: Int = 1
        while i <= 100 {
            if i % 2 == 0 and i % 3 == 0 {
                a = a + 1
            } elif i % 7 == 0 {
                b = b + 1
            } else {
                if not (i % 5 == 0) {
                    c = c + 1
                }
            }
            if i % 6 == 0 {
                e = e + 1
            }
            i = i + 1
        }

        print("a=", a, " b=", b, " c=", c, " e=", e)
        print("单独判断 and：", 1 == 1 and 2 == 2, "  ", 1 == 2 and 2 == 2)
        print("单独判断 or： ", 1 == 2 or 2 == 2, "  ", 1 == 2 or 2 == 3)
        print("单独判断 not：", not (1 == 2), "  ", not (1 == 1))
    }
}