// 缩小范围：elif + or 组合、else 里嵌 if 且累加 i
actor Main {
    on Start {
        h: Int = 0
        i: Int = 1
        while i <= 100_000 {
            if i % 2 == 0 and i % 3 == 0 {
                h = h + 1
            } elif i % 7 == 0 or i % 11 == 0 {
                h = h + 10
            }
            i = i + 1
        }
        print("A  h = ", h)

        s: Int = 0
        j: Int = 1
        while j <= 100_000 {
            if j % 6 == 0 {
                s = s + 1
            } else {
                if not (j % 5 == 0) {
                    s = s + j
                }
            }
            j = j + 1
        }
        print("B  s = ", s)
    }
}