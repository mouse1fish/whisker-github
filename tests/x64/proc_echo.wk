# proc_echo.wk —— 进程原语验收：捕获子进程输出 + 退出码
# 期望输出：子进程退出码=0 / 输出含 EonOS-OK / exit 7 的退出码=7
actor Main {
    on Start {
        p: Ptr = procSpawnPipe("cmd.exe /c echo EonOS-OK")
        if isNull(p) {
            print("procSpawnPipe 失败 err=", netErr())
        } else {
            buf: Ptr = alloc(1024)
            total: Int = 0
            n: Int = 1
            while n > 0 {
                n = procRead(p, ptrAdd(buf, total), 1024 - total)
                if n > 0 {
                    total = total + n
                }
            }
            code: Int = procWait(p)
            store8(ptrAdd(buf, total), 0)
            print("子进程退出码=", code)
            print("子进程输出: ", ptrToStr(buf))
            procFree(p)
        }

        q: Ptr = procSpawn("cmd.exe /c exit 7")
        if isNull(q) {
            print("procSpawn 失败")
        } else {
            c2: Int = procWait(q)
            print("exit 7 的退出码=", c2)
            procFree(q)
        }
    }
}
